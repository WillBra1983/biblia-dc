# Copie para .env e preencha com o projeto Firebase (Console > Configurações do projeto > Seus apps).
# Build APK: npm run build:android && npx cap sync android
# O Realtime Database tem de estar criado e as regras publicadas (database.rules.json).

# URL pública HTTPS do PWA (sem barra final). Se vazio no build, o compartilhamento usa
# https://foundcine.com/biblia (código). O mesmo link no WhatsApp: com App Links verificados abre o APK;
# sem o app, abre o site no navegador.
# VITE_PUBLIC_APP_URL=https://foundcine.com/biblia
#
# Deploy PWA no servidor Flask (foundcine): npm run build:web && npm run deploy:pwa-apis
# (copia dist → ..\apis\biblia_dist e public/.well-known → ..\apis\.well-known).

# (Opcional) Scheme do deep link nativo — Android + iOS (default com.bibliadc.app).
# VITE_NATIVE_APP_SCHEME=com.bibliadc.app
# VITE_ANDROID_APP_SCHEME=com.bibliadc.app

# —— iOS / App Store ——
# 1) Firebase: app iOS com bundle com.bibliadc.app → GoogleService-Info.plist em ios/App/App/
# 2) capacitor.config.json → plugins.GoogleAuth.iosClientId (cliente OAuth iOS do Google Cloud)
# --- Apple Developer (Universal Links / App Store) ---------------------------
APPLE_TEAM_ID=BDAN6452VU
APPLE_BUNDLE_ID=com.bibliadc.app
VITE_PUBLIC_APP_URL=https://foundcine.com/biblia
VITE_PRIVACY_POLICY_URL=https://foundcine.com/biblia/privacidade
VITE_APP_SUPPORT_URL=https://foundcine.com/biblia/sobre
VITE_NATIVE_APP_SCHEME=com.bibliadc.app
# GoogleService-Info.plist → ios/App/App/ (não commitar). Ver docs/FIREBASE_APPLE_SIGNIN.md
# npm run ios:appstore-status  |  docs/APPLE_PUBLICAR_AGORA.md  |  secrets: .github/APPLE_SECRETS_CHECKLIST.md

# Sem site no ar: no APK Android use intent:// no «Copiar link» / compartilhamento externo (abre o app direto).
# Desvantagem: WhatsApp pode não mostrar o link inteiro como clicável. Remova ou defina false quando publicar assetlinks.json.
# VITE_SHARE_ANDROID_USE_INTENT=true

# —— Android App Links (toque no link https abre o APK em vez do Chrome) ——
# Deve coincidir com android/app/build.gradle → manifestPlaceholders (appLinkHost, appLinkHostWww, appLinkPathPrefix).
# 1) SHA-256 em public/.well-known/assetlinks.json:
#    - APK assinado localmente: keytool -list -v -keystore android/salvation.keystore (SHA256 da assinatura).
#    - Google Play App Signing: Console → App → Configuração do app → assinatura do app — copie também para o JSON (pode haver várias linhas em sha256_cert_fingerprints).
# 2) Servir em HTTPS com Content-Type application/json:
#    https://foundcine.com/.well-known/assetlinks.json
#    https://www.foundcine.com/.well-known/assetlinks.json  (mesmo conteúdo; DNS deve apontar para o mesmo backend ou redirect estável)
#    No projeto apis (Flask): rota já exposta; ficheiro em apis/.well-known/assetlinks.json.
# 3) Web build com base /biblia/: npm run build:web (VITE_BASE_URL=/biblia/).
# 4) Rebuild APK: npm run android:sync — teste: adb shell pm get-app-links com.bibliadc.app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# (Opcional) Incrementar após alterar public/ot_strong.sqlite (ou outros .sqlite) para forçar novo fetch no cliente
# e recarregar o SQL.js em memória com a nova URL (?v=…). Útil em deploy sem cache antigo do PWA.
# VITE_SQLITE_ASSET_REV=1

# —— Resumo IA na página Estudo Strong (/estudo-strong/…) — Gemini (Google AI Studio) ——
# Google Cloud: uma chave por plataforma (Sites / Android / iOS). O app escolhe automaticamente.
# Android: restrinja a com.bibliadc.app + SHA-1 (Play App Signing + upload/debug se testar local).
# O app envia X-Android-Package / X-Android-Cert nas chamadas REST do WebView.
# Verifique: npm run gemini:config
VITE_GEMINI_API_KEY_WEB=
VITE_GEMINI_API_KEY_ANDROID=
VITE_GEMINI_API_KEY_IOS=
# Opcional (fallback se o plugin nativo falhar no Android):
# VITE_ANDROID_CERT_SHA1=
# Opcional (fallback se faltar a específica da plataforma):
# VITE_GEMINI_API_KEY=
# Opcional (predefinição: gemini-1.5-flash)
# VITE_GEMINI_MODEL=gemini-1.5-flash
# Resumo lexical Strong: '0' = só dados locais (sem Google Search); omitido ou '1' = enriquece com pesquisa web
# VITE_GEMINI_LEXICAL_WEB_ENRICHMENT=1
# Resumo lexical Strong: '0' ou 'false' = só dados locais (sem Google Search no Gemini).
# Omitido ou qualquer outro valor = enriquecimento com busca web (STEPBible, BLB, etc.).
# VITE_GEMINI_LEXICAL_WEB_ENRICHMENT=1

# Áudio bíblico experimental (versículo OT / pilotos / MP3 Strong). Omitido ou ≠ true = UI oculta,
# `dist/data/ot-hebrew-audio/` e `dist/sounds/strong-pron/*.mp3` removidos no build.
# Só para dev interno:
# VITE_BIBLICAL_AUDIO=true
