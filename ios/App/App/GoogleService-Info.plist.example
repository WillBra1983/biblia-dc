<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copie este arquivo para GoogleService-Info.plist (mesma pasta) após criar o app iOS
  no Firebase Console (bundle ID com.bibliadc.app). Não commite o .plist real se o
  repositório for público.

  No Xcode, adicione também o REVERSED_CLIENT_ID (valor CLIENT_ID invertido no plist
  real) em Info.plist → URL Types, conforme @codetrix-studio/capacitor-google-auth.
-->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>419144943323-0ik1cnsgjbkajq03kds8ojqkm6f1ocb5.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.419144943323-0ik1cnsgjbkajq03kds8ojqkm6f1ocb5</string>
	<key>API_KEY</key>
	<string>SUA_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>SEU_MESSAGING_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.bibliadc.app</string>
	<key>PROJECT_ID</key>
	<string>biblia-dc</string>
	<key>STORAGE_BUCKET</key>
	<string>biblia-dc.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:SEU_SENDER_ID:ios:SEU_APP_ID</string>
</dict>
</plist>
