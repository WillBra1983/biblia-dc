{
  "name": "biblia-dc",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "icons:pwa": "node scripts/gen-pwa-icons.mjs",
    "icons:pwa:force": "node scripts/gen-pwa-icons.mjs --force",
    "dev": "vite",
    "build": "vite build",
    "build:web": "cross-env VITE_BASE_URL=/biblia/ vite build",
    "build:web:lowmem": "cross-env VITE_BASE_URL=/biblia/ NODE_OPTIONS=--max-old-space-size=2048 vite build",
    "preview": "vite preview",
    "build:android": "cross-env VITE_BASE_URL= vite build",
    "build:ios": "cross-env VITE_BASE_URL= vite build",
    "build:native": "cross-env VITE_BASE_URL= vite build",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:build": "npm run build:android && npx cap sync android && cd android && gradlew bundleRelease",
    "android:build:linux": "npm run build:android && npx cap sync android && cd android && ./gradlew bundleRelease",
    "ios:sync": "npm run build:ios && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:inject-google-scheme": "node scripts/ios-inject-google-url-scheme.mjs",
    "ios:apply-team-id": "node scripts/ios-apply-team-id.mjs",
    "ios:free-status": "node scripts/ios-free-status.mjs",
    "ios:appstore-status": "node scripts/ios-appstore-status.mjs",
    "gemini:config": "node scripts/gemini-config.mjs",
    "ios:github-secrets": "powershell -ExecutionPolicy Bypass -File scripts/ios-prepare-github-secrets.ps1",
    "ios:gerar-secrets-desktop": "powershell -ExecutionPolicy Bypass -File scripts/ios-gerar-arquivo-para-github.ps1",
    "ios:setup-free": "node scripts/ios-setup-free.mjs",
    "deploy:rules": "firebase deploy --only database",
    "deploy:storage": "firebase deploy --only storage",
    "deploy:pwa-apis": "powershell -ExecutionPolicy Bypass -File scripts/deploy-pwa-para-apis.ps1",
    "rebuild:pericopes": "node scripts/rebuild-pericopes-from-ara-backup.mjs",
    "prova:nt": "python scripts/prova_nt_morphgnt_build.py",
    "build:strong:ot": "python scripts/build_ot_strong.py",
    "build:lexicon:ptbr": "python scripts/build_lexicon_ptbr.py",
    "build:stepbible": "python scripts/build_stepbible_lexicon.py",
    "build:strong:all": "npm run build:strong:ot && npm run prova:nt && npm run build:stepbible && npm run build:lexicon:ptbr",
    "sqlite:vacuum": "python scripts/sqlite-vacuum.py",
    "sqlite:precompress": "node scripts/sqlite-precompress.mjs",
    "sqlite:optimize": "npm run sqlite:vacuum && npm run sqlite:precompress",
    "setup:httpvfs": "node scripts/setup-httpvfs.mjs"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/share": "^6.0.4",
    "@capawesome/capacitor-badge": "^6.0.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fontsource/comic-neue": "^5.2.7",
    "@fontsource/dancing-script": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.8",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-tree-view": "^7.26.0",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.0",
    "md5": "^2.3.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.6",
    "react-router-dom": "^6.22.0",
    "react-window": "^1.8.11",
    "sql.js": "^1.12.0",
    "sql.js-httpvfs": "^0.8.12",
    "strongs": "^1.0.2",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@vitejs/plugin-react": "^4.2.0",
    "beasties": "^0.4.2",
    "cross-env": "^7.0.3",
    "firebase-tools": "^15.17.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
